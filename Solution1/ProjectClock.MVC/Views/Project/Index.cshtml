@using ProjectClock.BusinessLogic.Dtos.Project.ProjectDtos

@model IEnumerable<ProjectDto>

<div class="container p-2 m-1 box-shadow border-bottom">
    <div class="row">@await Component.InvokeAsync("CreateProject")</div>
</div>
<div class="container">
    <div class="row">
        @foreach (var item in @Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 d-flex">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">Organization: @item.Organization</p>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-primary col-12">Delete</button>
                            <input type="hidden" name="_method" value="POST" />
                        </form>
                        <button class="btn btn-sm btn-primary mt-2 col-12"
                                onclick="location.href='@Url.Action("Update", "Project", new { id = item.Id })'">
                            Modify
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


