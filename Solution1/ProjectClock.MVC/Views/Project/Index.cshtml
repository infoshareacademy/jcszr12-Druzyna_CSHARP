@using ProjectClock.BusinessLogic.Dtos.Project.ProjectDtos

@model IEnumerable<ProjectDto>

<div class="container bg-light bg-opacity-50 rounded-2 p-2 m-1 box-shadow">
    <div class="row">@await Component.InvokeAsync("CreateProject")</div>
</div>

@foreach (var group in Model.GroupBy(w => w.Organization))
{
    <div class="container bg-light bg-opacity-50 rounded-2 p-2 m-1 box-shadow">
        <div class="row">
            <h4 class="">Organization: @group.Key</h4>
            <div class="row">
                @foreach (var item in group)
                {
                    <div class="col-12 col-md-3 h-100">
                        <div class="card mb-3">
                            <div class="card-body">
                                <h5 class="card-title">@item.Name</h5>
                                <div class="row">
                                    <div class="col-3 col-md-12 mb-2">
                                        <button class="btn btn-sm btn-danger w-100"
                                                onclick="location.href='@Url.Action("Delete", "NewProject", new { id = item.Id })'">
                                            Delete
                                        </button>
                                    </div>
                                    <div class="col-3 col-md-12">
                                        <button class="btn btn-sm btn-primary w-100"
                                                onclick="location.href='@Url.Action("Modify", "NewProject", new { id = item.Id })'">
                                            Modify
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
