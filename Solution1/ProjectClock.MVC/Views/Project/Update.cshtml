@using ProjectClock.BusinessLogic.Dtos.Project.ProjectDtos

@model ProjectDto

<form id="Update" method="post">
    <div class="mb-3">
        <label for="selectedDateTime" class="form-label">Insert new project name</label>
        <input type="text" asp-for="@Model.Name" class="form-control" required />       
    </div>
    <button type="submit" class="btn btn-primary">Change</button>
</form>