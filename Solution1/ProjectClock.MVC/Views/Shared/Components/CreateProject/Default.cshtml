@using ProjectClock.BusinessLogic.Dtos.Organization

@model IEnumerable<OrganizationsDto>

<div class="row justify-content-center">
    <div class="col-md-4">
        <form id="home" method="post">
            <div class="form-group mb-3">
                <label for="Organization" class="control-label">Project</label>
                <select name="Organization" class="form-select form-select-lg">
                    @foreach (var organization in @Model)
                    {
                        <option value="@organization.OrganizationId">@organization.OrganizationName</option>
                    }
                </select>
                <label for="ProjectName" class="control-label">Name</label>
                <input for="ProjectName" type="text">
            </div>
            <div class="form-group mb-3">
                <input value="Create" type="submit" class="btn btn-primary">
            </div>
        </form>
    </div>
</div>
