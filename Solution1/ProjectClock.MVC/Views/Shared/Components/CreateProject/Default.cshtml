@using ProjectClock.BusinessLogic.Dtos.Organization

@model IEnumerable<OrganizationsDto>

<div class="row justify-content-center">
    <div class="col-md-4">
        <form action="/Project/Create" method="post">
            <div class="form-group mt-1">
                <label for="OrganizationName" class="control-label">Organization</label>
                <select name="OrganizationName" class="form-select form-select-lg">
                    @foreach (var organization in @Model)
                    {
                        <option value="@organization.OrganizationName">@organization.OrganizationName</option>
                    }
                </select>
                <label for="ProjectName" class="control-label mt-1">Name</label>
                <input name="ProjectName" type="text">
            </div>
            <div class="form-group mt-1">
                <input value="Create" type="submit" class="btn btn-primary">
            </div>
        </form>
    </div>
</div>
