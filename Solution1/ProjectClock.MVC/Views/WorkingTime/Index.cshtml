@using ProjectClock.BusinessLogic.Dtos.WorkingTime.WorkingTimeDtos
@model IEnumerable<WorkingTimeDto>

<div class="container">
    <h2>Display working times:</h2>
    <div class="row">
        <form id="dateForm">
            <label for="startDate">From:</label>
            <input type="date" id="startDate" name="startDate">
            <label for="endDate">To:</label>
            <input type="date" id="endDate" name="endDate">
            <input type="submit" value="Submit">
        </form>
    </div>
</div>

@foreach (var group in Model.GroupBy(w => w.StartTime.Date))
{
    <div class="container bg-light bg-opacity-50 rounded-2 p-2 m-1 box-shadow" id="@group.Key.ToShortDateString()">
        <div class="row">
            <h4 class="" >Date: @group.Key.ToShortDateString()</h4>
            <div class="container">
                <div class="container">
                    <div class="row">
                        <div class="col">
                            <div class="row font-weight-bold border border-bottom mb-2">
                                <div class="col ">Project Name</div>
                                <div class="col d-none d-md-block ">Is Finished</div>
                                <div class="col d-none d-md-block ">Start Time</div>
                                <div class="col d-none d-md-block ">End Time</div>
                                <div class="col">Time</div>
                                <div class="col">Action</div>
                            </div>
                        </div>
                    </div>

                    @foreach (var item in group)
                    {
                        <div class="row mb-2">
                            <div class="col">@item.ProjectName</div>
                            <div class="col d-none d-md-block">
                                @if (item.IsFinished)
                                {
                                    <p>Ended</p>
                                }
                                else
                                {
                                    <p>In progress</p>
                                }
                            </div>
                            <div class="col d-none d-md-block">@item.StartTime.ToString("yyyy-MM-dd HH:mm:ss")</div>
                            <div class="col d-none d-md-block">
                                @if (item.IsFinished)
                                {
                                    <p>@item.EndTime.ToString("yyyy-MM-dd HH:mm:ss")</p>
                                }
                                else
                                {
                                    <p>-</p>
                                }
                            </div>
                            @{
                                var totalTime = item.EndTime - item.StartTime;
                            }
                            <div class="col">
                                @if (item.IsFinished)
                                {
                                    <p>@totalTime.ToString(@"hh\:mm\:ss")</p>
                                }
                                else
                                {
                                    <p>-</p>
                                }
                            </div>
                            <div class="col">
                                <div class="row">
                                    <div class="col-4 col-sm-12">
                                        <a asp-action="Update"
                                           asp-route-id="@item.Id"
                                           class="btn btn-danger btn-sm text-center">Modify</a>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-4 col-sm-12 pt-1">
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                            <button type="submit" class="btn btn-danger btn-sm text-center">Delete</button>
                                            <input type="hidden" name="_method" value="POST" />
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>   
}
<script>
  

    document.getElementById('dateForm').addEventListener('submit', function (e) {
        var startDate = new Date(document.getElementById('startDate').value);
        var endDate = new Date(document.getElementById('endDate').value);

        if (startDate > endDate) {
            alert('Start date must be less or equal to end date');
            e.preventDefault();

            document.getElementById('startDate').value = '';
            document.getElementById('endDate').value = '';
        }
        else {
            foreach(){ }
            document.getElementById('results').style.display = 'block';
        }

    });

    $(document).ready(function () {
        var today = new Date().toISOString().split('T')[0];
        var oneWeekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];

        $('#startDate').val(oneWeekAgo);
        $('#endDate').val(today);

        $('#startDate, #endDate').change(function () {
            var startDate = $('#startDate').val();
            var endDate = $('#endDate').val();

            console.log("Selected Start Date:", startDate);
            console.log("Selected End Date:", endDate);
        });
    });
</script>
