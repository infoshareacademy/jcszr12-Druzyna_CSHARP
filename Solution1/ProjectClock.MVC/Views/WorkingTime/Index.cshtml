@using ProjectClock.BusinessLogic.Dtos.WorkingTime.WorkingTimeDtos
@model IEnumerable<WorkingTimeDto>

@foreach (var group in Model.GroupBy(w => w.StartTime.Date))
{
    <div class="container bg-light bg-opacity-50 rounded-2 p-2 m-1 box-shadow">
        <div class="row">
            <h4 class="">Date: @group.Key.ToShortDateString()</h4>
            <div class="table-responsive">
                <table class="table table-info bg-opacity-25">
                    <thead>
                        <tr>
                            <th>Project Name</th>
                            <th class="d-none d-sm-table-cell">Is Finished</th>
                            <th class="d-none d-sm-table-cell">Start Time</th>
                            <th class="d-none d-sm-table-cell">End Time</th>
                            <th>Time</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in group)
                        {
                            <tr>
                                <td>@item.ProjectName</td>
                                <td class="d-none d-sm-table-cell">@(item.IsFinished ? "Ended" : "In progress")</td>
                                <td class="d-none d-sm-table-cell">@item.StartTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="d-none d-sm-table-cell">@(item.IsFinished ? @item.EndTime.ToString("yyyy-MM-dd HH:mm:ss") : "-")</td>
                                @{
                                    var totalTime = item.EndTime - item.StartTime;
                                }
                                <td>@(item.IsFinished ? totalTime.ToString("HH-mm") : "-")</td>
                                <td>
                                    <div class="container">
                                        <div class="row">
                                            <div class="col-4 col-sm-12 ">
                                                <button class="btn btn-sm btn-danger" 
                                                onclick="location.href='@Url.Action("Delete", "Home", new { id = item.Id })'">Delete
                                            </button></div>
                                        </div>
                                        <div class="row">
                                            <div class="col-4 col-sm-12 pt-1">
                                                <button class="btn btn-sm btn-primary" 
                                                onclick="location.href='@Url.Action("Modify", "Home", new { id = item.Id })'">Modify
                                            </button></div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
