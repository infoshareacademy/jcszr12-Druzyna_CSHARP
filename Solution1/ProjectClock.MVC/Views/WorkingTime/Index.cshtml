@using ProjectClock.BusinessLogic.Dtos.WorkingTime.WorkingTimeDtos

@model IEnumerable<WorkingTimeDto>
@foreach (var group in Model.GroupBy(w => w.StartTime.Date))
{
    <div class="container bg-light bg-opacity-50 rounded-2 p-2 m-1 box-shadow">
        <div class="row">
            <h4 class="">Date: @group.Key.ToShortDateString()</h4>
            <div class="table-responsive">
                <table class="table table-info bg-opacity-25">
                    <thead>
                        <tr>
                            <th>Project Name</th>
                            <th>Is Finished</th>
                            <th>Start Time</th>
                            <th>End Time</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in group)
                        {
                            <tr>                              
                                <td>@item.ProjectName</td>
                                <td>@(item.IsFinished ? "Ended" : "In progress")</td>
                                <td>@item.StartTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@(item.IsFinished ? @item.EndTime.ToString("yyyy - MM - dd HH: mm: ss") : "-") </td>
                                <td>
                                    <button class="btn btn-danger m-1" onclick="location.href='@Url.Action("Delete", "Home", new { id = item.Id })'">Delete</button>
                                    <button class="btn btn-primary m-1" onclick="location.href='@Url.Action("Modify", "Home", new { id = item.Id })'">Modify</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
</div>
      
}
